{
  "name": "wjx-cli",
  "version": "0.3.5",
  "description": "问卷星 (Wenjuanxing) CLI — AI Agent 原生命令行工具",
  "main": "dist/index.js",
  "bin": {
    "wjx": "dist/index.js"
  },
  "files": [
    "dist",
    "bundled"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json",
    "test": "npm run build && node --test __tests__/*.test.mjs",
    "perf:startup": "node scripts/benchmark-startup.mjs --enforce",
    "manifest:export": "node scripts/export-manifest.mjs",
    "manifest:check": "node scripts/export-manifest.mjs --check",
    "architecture:check": "node scripts/check-architecture-contract.mjs",
    "clean": "rm -rf dist",
    "sync-bundled": "node scripts/sync-bundled.mjs",
    "prepublishOnly": "npm run sync-bundled && npm run build"
  },
  "keywords": [
    "wjx",
    "wenjuanxing",
    "survey",
    "cli"
  ],
  "author": "wjxagents",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjxcom/wjx-ai-kit.git",
    "directory": "wjx-cli"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "wjx-api-sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
