# 问卷星 OpenAPI API Key
WJX_API_KEY=sk-wjx-xxx

# 企业通讯录 ID（通讯录相关操作需要）
# WJX_CORP_ID=orgXXXXXXXXXX

# HTTP 传输模式（可选，默认 stdio）
# MCP_TRANSPORT=http
# PORT=3000
# MCP_AUTH_TOKEN=your_http_access_token
# 单租户上游 API Key（可与 MCP_AUTH_TOKEN 不同）
# WJX_API_KEY=sk-wjx-xxx
# 多租户模式：每个请求用 X-WJX-API-Key 提供上游 key
# MCP_TENANT_MODE=1
# 仅为兼容旧部署才开启 Bearer 兼作上游 API Key
# MCP_LEGACY_BEARER_API_KEY=1
# MCP_SESSION=stateful
