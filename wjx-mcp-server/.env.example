# 问卷星 OpenAPI API Key
WJX_API_KEY=sk-wjx-xxx

# 企业通讯录 ID（通讯录相关操作需要）
# WJX_CORP_ID=orgXXXXXXXXXX

# HTTP 传输模式（可选，默认 stdio）
# MCP_TRANSPORT=http
# PORT=3000
# MCP_AUTH_TOKEN 只保护 MCP HTTP 入口，不会作为问卷星 OpenAPI Key 转发。
# MCP_AUTH_TOKEN=your_bearer_token
# MCP_SESSION=stateful
# 仅精确列出的代理 IP 可以提供 X-Forwarded-For/X-Real-Ip；默认不信任转发头。
# MCP_TRUSTED_PROXIES=127.0.0.1,10.0.0.10
