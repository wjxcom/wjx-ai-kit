# 依赖
node_modules/

# 构建产物
dist/
**/dist/
build/
**/build/

# 测试源码与产物
__tests__/
**/__tests__/
*.test.mjs
*.test.ts
*.test.js
*.spec.mjs
*.spec.ts
*.spec.js
coverage/
**/coverage/
.nyc_output/

# First-party acceptance tests are part of the source tree.  The repository
# keeps a broad test ignore rule for generated/consumer copies, so explicitly
# reopen only the workspace test directories used by package scripts.
!wjx-api-sdk/__tests__/
!wjx-api-sdk/__tests__/*.test.mjs
!wjx-cli/__tests__/
!wjx-cli/__tests__/*.test.mjs
!wjx-mcp-server/__tests__/
!wjx-mcp-server/__tests__/*.test.mjs
!wjx-mcp-server/tests/*.test.mjs
wjx-cli/__tests__/__tmp_sync_bundled__/

# 环境变量
.env
.env.*
!.env.example

# 日志
*.log

# 密钥
*.key

# 操作系统
.DS_Store
Thumbs.db

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 临时文件
__*.txt
tmp-*.txt
_*.mjs

# Claude Code
.claude/plans/
.claude/scheduled_tasks.lock

# MCP client configuration (opt-in; may contain credentials)
.claude/mcp.json
.cursor/mcp.json
.mcp.json

# Local Codex overrides (machine-specific Skill paths)
.codex/config.toml

# wjx-cli 配置（含 API Key）
**/.wjxrc
*.zip
